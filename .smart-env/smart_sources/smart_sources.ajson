omorfismo","line":48},{"title":"matter","target":"Matéria (Filosofia)","line":48},{"title":"matter","target":"Matéria (Filosofia)","line":48},{"title":"Accidental changes","target":"Mudança Acidental","line":48},{"title":"accidental properties","target":"Propriedades Acidentais","line":48},{"title":"essential properties","target":"Propriedades Essenciais","line":48},{"title":"#1. Introduction","target":"#1. Introduction","line":53,"section":"1. Introduction"},{"title":"#2. Identity and Change","target":"#2. Identity and Change","line":54,"section":"2. Identity and Change"},{"title":"#2.1 Diachronic and Synchronic Identity","target":"#2.1 Diachronic and Synchronic Identity","line":55,"section":"2.1 Diachronic and Synchronic Identity"},{"title":"#2.2 Identity as an Equivalence Relation","target":"#2.2 Identity as an Equivalence Relation","line":56,"section":"2.2 Identity as an Equivalence Relation"},{"title":"#2.3 Leibniz’s Law and the Possibility of Change: The Problem of Temporary Intrinsics","target":"#2.3 Leibniz’s Law and the Possibility of Change: The Problem of Temporary Intrinsics","line":57,"section":"2.3 Leibniz’s Law and the Possibility of Change: The Problem of Temporary Intrinsics"},{"title":"#2.4 Candidate Solutions","target":"#2.4 Candidate Solutions","line":58,"section":"2.4 Candidate Solutions"},{"title":"#3. Necessary and Determinate Identities","target":"#3. Necessary and Determinate Identities","line":59,"section":"3. Necessary and Determinate Identities"},{"title":"#4. Diachronic Identity Puzzles","target":"#4. Diachronic Identity Puzzles","line":60,"section":"4. Diachronic Identity Puzzles"},{"title":"#4.1 Constitution","target":"#4.1 Constitution","line":61,"section":"4.1 Constitution"},{"title":"#4.2 Relative Identity","target":"#4.2 Relative Identity","line":62,"section":"4.2 Relative Identity"},{"title":"#4.3 Identity: ‘Strict’ and ‘Loose’","target":"#4.3 Identity: ‘Strict’ and ‘Loose’","line":63,"section":"4.3 Identity: ‘Strict’ and ‘Loose’"