rsistir a si mesma no ambiente.","Contrato de Fronteira Acionado":"Governado pelo Contrato de Competência (criação) e Execução Transitória (isolamento).","Tipo de Artefato":"Interface de Serviço"},"blocks_data":{"#---frontmatter---":{"text":null,"length":0,"last_read":{"hash":"xw2gux","at":1787679069923},"key":"Noosphera/02_ARCHITECTURE/06 — Engenharia de Design/Contratos de Materialização Arquitetural/Competency Interface.md#---frontmatter---","lines":[1,15],"size":1050,"should_embed":true,"embedding":{"history":[],"default":{"mf_7gwptj":{"file":"mf_7gwptj","file_i":1344,"read_hash":"xw2gux","at":1787679122990}}}}},"block_embedding_selection":{"version":2,"min_chars":200,"max_input_chars":1894,"source_key":"Noosphera/02_ARCHITECTURE/06 — Engenharia de Design/Contratos de Materialização Arquitetural/Competency Interface.md","requires_reimport":false},"task_lines":[],"tasks":{},"codeblock_ranges":[],"outlinks_version":2,"key":"Noosphera/02_ARCHITECTURE/06 — Engenharia de Design/Contratos de Materialização Arquitetural/Competency Interface.md"},
