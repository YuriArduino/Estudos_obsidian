filters:
  and:
    - note["base"] == link("Contratos de Sustentação Arquitetural.base")
formulas:
  Rollup 2: note["Atende qual Componente?"].map(value.asFile().properties["Responsabilide"])
  Rollup 1: note["Atende qual Componente?"].map(value.asFile().properties["Objeto de Sustentação"])
  Rollup: note["Atende qual Componente?"].map(value.asFile().properties["Função Arquitetural"])
properties:
  file.name:
    displayName: Padrão / Contrato
  Atende qual Componente?:
    displayName: Atende qual Componente?
  Tipo de Artefato:
    displayName: Tipo de Artefato
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Atende qual Componente?
      - Tipo de Artefato
      - formula.Rollup 2
      - formula.Rollup 1
      - formula.Rollup
